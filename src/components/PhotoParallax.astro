---
interface Props {
  foto: string;
  fotoMobile?: string;
  height?: string;
  heightMobile?: string;
  bgPosition?: string;
  parallaxAmplitude?: number;
  id?: string;
}
const { foto, fotoMobile, height = '55vh', heightMobile, bgPosition = 'center', parallaxAmplitude = 15, id = '' } = Astro.props;
---
<div
  class="parallax-section"
  style={`--h: ${height}; ${heightMobile ? `--h-mobile: ${heightMobile};` : ''}`}
  data-amp={parallaxAmplitude}
  id={id}
>
  <div
    class="parallax-bg"
    style={`--bg: url('${foto}'); --bg-pos: ${bgPosition}; ${fotoMobile ? `--bg-mobile: url('${fotoMobile}');` : ''}`}
  ></div>
  <div class="parallax-overlay"></div>
</div>

<style>
  .parallax-section {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: var(--h);
  }

  @media (max-width: 480px) {
    .parallax-section {
      height: var(--h-mobile, var(--h));
    }
  }

  .parallax-bg {
    position: absolute;
    inset: -20% 0;
    background-image: var(--bg);
    background-size: cover;
    background-position: var(--bg-pos, center);
    will-change: transform;
  }

  @media (max-width: 480px) {
    .parallax-bg {
      background-image: var(--bg-mobile, var(--bg));
    }
  }

  .parallax-overlay {
    position: absolute;
    inset: 0;
    /* Mismo velo que el Hero (.hero-overlay) */
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--eucalipto-noche) 72%, transparent) 0%,
      color-mix(in srgb, var(--sombra) 65%, transparent) 50%,
      color-mix(in srgb, var(--eucalipto-noche) 78%, transparent) 100%
    );
  }
</style>
