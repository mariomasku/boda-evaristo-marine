---
interface Props {
  foto: string;
  fotoMobile?: string;
  height?: string;
  id?: string;
}
const { foto, fotoMobile, height = '55vh', id = '' } = Astro.props;
---
<div class="parallax-section" style={`height: ${height}`} id={id}>
  <div
    class="parallax-bg"
    style={`--bg: url('${foto}'); ${fotoMobile ? `--bg-mobile: url('${fotoMobile}');` : ''}`}
  ></div>
  <div class="parallax-overlay"></div>
</div>

<style>
  .parallax-section {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .parallax-bg {
    position: absolute;
    inset: -20% 0;
    background-image: var(--bg);
    background-size: cover;
    background-position: center;
    will-change: transform;
  }

  @media (max-width: 480px) {
    .parallax-bg {
      background-image: var(--bg-mobile, var(--bg));
    }
  }

  .parallax-overlay {
    position: absolute;
    inset: 0;
    /* Mismo velo que el Hero (.hero-overlay) */
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--eucalipto-noche) 72%, transparent) 0%,
      color-mix(in srgb, var(--sombra) 65%, transparent) 50%,
      color-mix(in srgb, var(--eucalipto-noche) 78%, transparent) 100%
    );
  }
</style>
