<div class="lang-switcher" role="group" aria-label="Selector de idioma / Sélecteur de langue">
  <button type="button" class="lang-flag" data-lang="es" aria-label="Español" title="Español">🇪🇸</button>
  <button type="button" class="lang-flag" data-lang="fr" aria-label="Français" title="Français">🇫🇷</button>
</div>

<style>
  .lang-switcher {
    display: flex;
    gap: 0.35rem;
  }

  .lang-flag {
    background: none;
    border: none;
    font-size: 1.1rem;
    line-height: 1;
    padding: 0.2rem 0.3rem;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s, transform 0.15s;
  }

  .lang-flag:hover {
    opacity: 1;
    transform: translateY(-1px);
  }
</style>

<script>
  import type { Lang } from '../i18n/engine';

  // No importa `apply`/`apply.admin` directamente: este componente se reutiliza en
  // la web pública y en el panel privado, cada una con su propio diccionario. Solo
  // dispara el evento; la instancia de i18n cargada en cada página lo escucha.
  document.querySelectorAll<HTMLButtonElement>('.lang-flag').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.lang as Lang;
      window.dispatchEvent(new CustomEvent('lang-switch-request', { detail: { lang } }));
    });
  });
</script>
