---
import SectionTitle from './SectionTitle.astro';
---
<section id="detalles" class="details-section">
  <div class="container">
    <p class="section-subtitle gsap-fade" data-i18n="details.subtitle">la celebración</p>
    <SectionTitle i18n="details.title">El gran día</SectionTitle>

    <p class="event-date gsap-fade" data-i18n="details.eventDate">Viernes · 2 de octubre · 2026</p>
    <button class="cal-btn gsap-fade" id="cal-btn">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="1" y="3" width="14" height="12" rx="1.5"/>
        <path d="M1 7h14M5 1v4M11 1v4"/>
      </svg>
      <span data-i18n="details.calBtn">Añadir a mi calendario</span>
    </button>

    <div class="timeline-v">

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/position.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time">18:00h</time>
          <p class="tl-label"><span data-i18n="details.tlSalidaLabel">Salida de autocar</span><br><span data-i18n="details.tlSalidaPlace">Puerta de Almodóvar</span></p>
          <a
            href="https://maps.app.goo.gl/DX1rZZSyfFRoUjFJ6"
            target="_blank"
            rel="noopener"
            class="tl-maps-link"
          >
            <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 1a5 5 0 0 1 5 5c0 4-5 9-5 9S3 10 3 6a5 5 0 0 1 5-5z"/>
              <circle cx="8" cy="6" r="2"/>
            </svg>
            <span data-i18n="details.tlSalidaMapLink">Ver ubicación</span>
          </a>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/anillos.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time">18:30 – 19:30h</time>
          <p class="tl-label" data-i18n="details.tlCeremonia">Ceremonia laica</p>
          <p class="tl-officiants" data-i18n="details.tlOficiantes">Oficiada por Samuel Belaud y José Luis Arjona.</p>
          <a
            href="#mapa"
            target="_blank"
            rel="noopener"
            class="tl-maps-link"
          >
            <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 1a5 5 0 0 1 5 5c0 4-5 9-5 9S3 10 3 6a5 5 0 0 1 5-5z"/>
              <circle cx="8" cy="6" r="2"/>
            </svg>
            <span data-i18n="details.tlCeremoniaLink">Finca El Capricho</span>
          </a>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/coctel.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          
          <time class="tl-time">20:00h</time>
          <p class="tl-label" data-i18n="details.tlCoctel">Cóctel</p>
          
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/fotos.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time">21:30h</time>
          <p class="tl-label" data-i18n="details.tlCena">Cena</p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/bus.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time">03:00h</time>
          <p class="tl-label"><span data-i18n="details.tlPrimerAutocar">Primer autocar</span><br><span data-i18n="details.tlPrimerAutocarPlace">Finca El Capricho · Córdoba</span></p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/bus.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <div class="tl-stem"></div>
        </div>
        <div class="tl-right">
          <time class="tl-time">06:00h</time>
          <p class="tl-label"><span data-i18n="details.tlSegundoAutocar">Segundo autocar</span><br><span data-i18n="details.tlSegundoAutocarPlace">Finca El Capricho · Córdoba</span></p>
        </div>
      </div>

      <div class="tl-item">
        <div class="tl-left">
          <div class="tl-icon-wrap">
            <img src="/icons/ceremonia.svg" alt="" class="tl-icon" aria-hidden="true" />
          </div>
          <!-- sin stem: último ítem -->
        </div>
        <div class="tl-right">
          <time class="tl-time">06:00h</time>
          <p class="tl-label" data-i18n="details.tlFinFiesta">Fin de fiesta</p>
        </div>
      </div>

    </div>

  </div>

  <div class="container" id="mapa">
    <p class="section-subtitle gsap-fade como-llegar" data-i18n="details.comoLlegar">Cómo llegar</p>
    <div class="ornament gsap-fade">
      <span style="color: var(--oro); font-size:1.2rem;">✦</span>
    </div>
  </div>

  <!-- Mapa -->
  <div class="map-wrapper gsap-fade" >
    <div class="map-label">
      <span data-i18n="details.mapLabel">📍 Finca El Capricho · Alcolea, Córdoba</span>
      <a
        href="https://maps.app.goo.gl/AXdcVG4tCo7STsLf6"
        target="_blank"
        rel="noopener"
        class="map-open-link"
        data-i18n="details.mapOpenLink"
      >Abrir en Google Maps →</a>
    </div>
    <iframe
      title="Localización de Finca El Capricho"
      data-i18n-title="details.mapTitle"
      src="https://maps.google.com/maps?q=37.9409249,-4.662873&output=embed&z=15"
      width="100%"
      height="400"
      style="border:0"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</section>

<script>
  import { t, getCurrentLang } from '../i18n/apply';

  function buildIcs(): string {
    const lang = getCurrentLang();
    return [
      'BEGIN:VCALENDAR',
      'VERSION:2.0',
      'PRODID:-//Boda Marine y Evaristo//ES',
      'CALSCALE:GREGORIAN',
      'BEGIN:VEVENT',
      'DTSTART;TZID=Europe/Madrid:20261002T183000',
      'DTEND;TZID=Europe/Madrid:20261003T060000',
      `SUMMARY:${t(lang, 'details.icsSummary')}`,
      `LOCATION:${t(lang, 'details.icsLocation').replace(/,/g, '\\,')}`,
      `DESCRIPTION:${t(lang, 'details.icsDescription')}`,
      'END:VEVENT',
      'END:VCALENDAR',
    ].join('\r\n');
  }

  document.getElementById('cal-btn')?.addEventListener('click', async () => {
    const lang = getCurrentLang();
    const filename = t(lang, 'details.icsFilename');
    const blob = new Blob([buildIcs()], { type: 'text/calendar;charset=utf-8' });
    const file = new File([blob], filename, { type: 'text/calendar' });

    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);

    // Web Share API con archivo: abre el selector nativo (funciona en iOS Safari y
    // Chrome Android moderno cuando el dispositivo lo soporta)
    if (navigator.canShare?.({ files: [file] })) {
      try {
        await navigator.share({ files: [file] });
        return;
      } catch (err) {
        if ((err as DOMException).name === 'AbortError') return;
      }
    }

    if (isIOS) {
      // iOS: webcal:// abre la app Calendario del sistema directamente
      window.location.href = `webcal://${window.location.host}/boda.ics`;
      return;
    }

    // Android y escritorio: descarga el .ics
    // En Android el sistema muestra "Abrir con…" → Google Calendar, Samsung Calendar, etc.
    const url = URL.createObjectURL(blob);
    const a   = document.createElement('a');
    a.href     = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray<HTMLElement>('.tl-item').forEach((item) => {
    const left  = item.querySelector<HTMLElement>('.tl-left');
    const right = item.querySelector<HTMLElement>('.tl-right');

    // Estado inicial: oculto
    gsap.set(item, { opacity: 0 });
    if (left)  gsap.set(left,  { x: -18, opacity: 0 });
    if (right) gsap.set(right, { x:  18, opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: item,
        start: 'top 86%',
        toggleActions: 'play none none reverse',
      },
    });

    tl.to(item,  { opacity: 1, duration: 0.01 })          // saca el contenedor del display:none implícito
      .to(left,  { x: 0, opacity: 1, duration: 0.45, ease: 'power2.out' }, 0)
      .to(right, { x: 0, opacity: 1, duration: 0.45, ease: 'power2.out' }, 0.1);
  });
</script>

<style>
  .details-section {
    padding: 6rem 1.5rem 5rem;
    background: var(--crema);
    background-image: url(../../public/img/fondo-floral2.webp);
  }
  
  .details-section > * {
    position: relative;
    z-index: 1;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-bottom: 4rem;
  }

  .section-subtitle { margin-bottom: 0.25rem; }
  .section-title { margin-bottom: 0; }

  /* ── Vertical timeline ── */
  .timeline-v {    
    margin: 2.5rem auto;
  }

  .tl-item {
    display: flex;
    gap: 2.4rem;
  }

  /* Columna izquierda: icono + línea vertical */
  .tl-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 80px;
  }

  .tl-icon-wrap {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: var(--crema);
    background: var(--marfil);
    border: 1px solid color-mix(in srgb, var(--oro) 45%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tl-icon {
    width: 60px;
    height: 60px;
    filter: brightness(0) sepia(1) saturate(0.5) brightness(0.65);
  }

  /* Línea que conecta con el siguiente icono */
  .tl-stem {
    flex: 1;
    width: 1px;
    min-height: 24px;
    background: var(--oro);
    opacity: 0.4;
    margin: 5px 0;
  }

  /* Columna derecha: hora encima, etiqueta debajo */
  .tl-right {
    width: max-content;
    padding-top: 0.75rem;
    padding-bottom: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tl-time {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: var(--eucalipto);
    font-style: italic;
    display: block;
    line-height: 1;
  }

  .tl-time--main {
    font-size: 1.45rem;
  }

  .tl-label {
    font-family: 'Lato', sans-serif;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--salvia);
    line-height: 1.7;
    margin: 0;
  }

  .tl-officiants {
    font-family: 'Lato', sans-serif;
    font-style: italic;
    font-size: 0.72rem;
    color: var(--eucalipto);
    line-height: 1.5;
    margin: 0.15rem 0 0.3rem;
    max-width: 260px;
  }

  /* ── Fecha y botón calendario ── */
  .event-date {
    font-family: 'Playfair Display', serif;
    font-size: 1.7rem;
    font-style: italic;
    color: var(--salvia);
    text-align: center;
    letter-spacing: 0.03em;
    margin: 0;
  }

  .cal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1.5rem;
    border: 1px solid var(--oro);
    background: transparent;
    color: var(--eucalipto);
    font-family: 'Lato', sans-serif;
    font-size: 0.74rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    margin-bottom: 0.5rem;
  }

  .cal-btn:hover {
    background: var(--oro);
    color: var(--blanco);
  }

  /* ── Maps link en timeline ── */
  .tl-maps-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--salvia);
    text-decoration: none;
    font-family: 'Lato', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    border-bottom: 1px solid color-mix(in srgb, var(--oro) 40%, transparent);
    padding-bottom: 1px;
    margin-bottom: 0.4rem;
    transition: color 0.2s;
  }

  .tl-maps-link:hover { color: var(--eucalipto); }

  /* ── Mapa ── */
  .map-wrapper {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 24px color-mix(in srgb, var(--sombra) 10%, transparent);
  }

  .map-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 1rem;
    background: var(--crema);
    border-top: 2px solid var(--oro);
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    color: var(--eucalipto);
  }

  .map-open-link {
    color: var(--salvia);
    text-decoration: none;
    font-size: 0.8rem;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .map-open-link:hover { color: var(--eucalipto); }

  .map-wrapper iframe {
    display: block;
    filter: grayscale(20%) contrast(1.05);
  }

  @media (max-width: 480px) {
    .tl-icon-wrap { width: 100px; height: 100px; }
    .tl-icon { width: 60px; height: 60px; }
    .tl-left { width: 44px; }
    .timeline-v { padding-left: 1.2rem; padding-right: 1.2rem}

    /* Mapa circular en móvil */
    .map-wrapper {
      box-shadow: none;
      border-radius: 0;
      overflow: visible;
      display: flex;
      flex-direction: column;
      align-items: center;
      background: transparent;
      margin-bottom: -0.2rem;
    }
    .map-label {
      flex-direction: column;
      gap: 0.4rem;
      text-align: center;
      border-top: none;
      background: transparent;
      padding: 0 0 1.2rem;
    }
    .map-wrapper iframe {
      width: 260px;
      height: 260px;
      border-radius: 50%;
      box-shadow: 0 6px 24px color-mix(in srgb, var(--sombra) 18%, transparent);
    }
  }
</style>
