---
import SectionTitle from './SectionTitle.astro';
---
<section class="welcome-section">
  <div class="welcome-container">
    <SectionTitle i18n="welcome.title">Nuestra historia</SectionTitle>
    <p class="section-subtitle gsap-fade" data-i18n="welcome.subtitle">Los viajes más bellos son, a veces, aquellos que no hemos planeado.</p>
    <div class="welcome-ornament gsap-fade">
      <span>✦</span>
    </div>
    <div class="welcome-text">
      <p data-i18n="welcome.p1">Nunca había imaginado mi vida fuera de Córdoba. Pero una noche nuestras vidas se cruzaron y, desde ese momento, todo empezó a cambiar.</p>
      <p data-i18n="welcome.p2">Lo que, en un principio, iba a ser una vuelta a casa tras un año de transición en Granada dio paso a una nueva vida en otro país. Y donde antes éramos dos, pasamos a ser tres con Julie.</p>
      <p data-i18n="welcome.p3">Años después llegó Lucas. La familia creció y seguimos construyendo nuestro futuro juntos.</p>
      <p class="welcome-closing" data-i18n="welcome.closing">Ahora, quince años después, queremos celebrar nuestro amor junto a vosotros.</p>
      <!-- <svg
        class="amor-svg"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 680 130"
        aria-label="el amor."
        role="img"
        overflow="visible"
      >
        <text id="amor-text" x="340" y="98" data-i18n="welcome.amorSvg">el amor.</text>
      </svg>-->
    </div>
    <div class="welcome-ornament gsap-fade">
      <span>✦</span>
    </div>
  </div>
</section>

<style>
  .welcome-section {
    padding: 6rem 1.5rem;
    background: var(--marfil);
  }

  .welcome-container {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .welcome-ornament {
    color: var(--oro);
    font-size: 1.3rem;
    opacity: 0.7;
  }

  .welcome-text {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    text-align: center;
  }

  .welcome-text p {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(1.55rem, 2.8vw, 2.1rem);
    line-height: 1.4;
    color: var(--eucalipto);
    font-weight: 300;
  }

  .welcome-closing {
    color: var(--eucalipto) !important;
    font-weight: 600 !important;
  }

  .amor-svg {
    height: auto;
    overflow: visible;
    color: var(--salvia);
  }

  #amor-text {
    font-family: 'Dancing Script', cursive;
    font-size: 100px;
    font-weight: 400;
    font-style: italic;
    text-anchor: middle;
    fill: transparent;
    stroke: currentColor;
    stroke-width: 0.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Estado inicial antes de que GSAP tome el control */
  .welcome-text p { opacity: 0; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // Evita que iOS Safari refresque (y "salte" el scroll) al aparecer/desaparecer
  // la barra de direcciones o el teclado.
  ScrollTrigger.config({ ignoreMobileResize: true });

  document.fonts.ready.then(() => {
    // ── Preparar "el amor." (estado inicial + función de dibujo) ──
    // Se define primero para poder dispararlo al terminar el revelado de texto.
    const textEl = document.getElementById('amor-text') as SVGTextElement | null;
    const svgEl  = document.querySelector<SVGElement>('.amor-svg');
    let drawAmor = () => {};

    if (textEl && svgEl) {
      const len = textEl.getComputedTextLength() * 1.02;
      textEl.setAttribute('stroke-dasharray', String(len));
      textEl.setAttribute('stroke-dashoffset', String(len));
      const fillColor = getComputedStyle(svgEl).color;
      let played = false;

      drawAmor = () => {
        if (played) return;   // solo una vez
        played = true;
        gsap.timeline()
          // Fase 1: se dibuja el trazo letra a letra (dashoffset no está en CSS → attr es seguro)
          .to(textEl, {
            attr: { 'stroke-dashoffset': 0 },
            duration: 2.4,
            ease: 'power1.inOut',
          })
          // Fase 2: fill y strokeOpacity como inline styles (prevalecen sobre el CSS)
          .to(textEl, {
            fill: fillColor,
            strokeOpacity: 0,
            duration: 0.9,
            ease: 'power2.out',
            onComplete: () => { textEl.style.stroke = 'none'; },
          }, '-=0.5');
      };
    }

    // ── Revelado palabra a palabra atado al scroll ──
    // Todas las palabras de todos los párrafos se animan en UNA sola línea de
    // tiempo y en orden (revelado estrictamente secuencial). Al completarse el
    // rango del scroll (onLeave), se dispara el dibujo de "el amor.".
    const container = document.querySelector<HTMLElement>('.welcome-text');
    if (container) {
      const allWords: Element[] = [];
      gsap.utils.toArray<HTMLElement>('.welcome-text p').forEach((p) => {
        const split = new SplitText(p, { type: 'words' });
        gsap.set(p, { opacity: 1 });          // el párrafo es visible…
        allWords.push(...split.words);        // …y acumulamos sus palabras en orden
      });

      gsap.set(allWords, { opacity: 0.15 });  // todas empiezan apagadas
      gsap.to(allWords, {
        opacity: 1,
        ease: 'none',
        stagger: 0.5,        // cada palabra arranca a mitad de la anterior (cascada suave)
        duration: 1,
        scrollTrigger: {
          trigger: container,
          start: 'top 78%',
          end: 'bottom 62%',
          scrub: true,
          onLeave: drawAmor,     // el texto ha terminado de revelarse → dibuja "el amor."
        },
      });
    }

    ScrollTrigger.refresh();
  });
</script>